# Plantilla de producción. Copia a .env.prod (ignorado por git) y reemplaza
# cada CHANGE_ME. Genera secretos aleatorios con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Usa valores base64url (sin caracteres especiales) para POSTGRES_PASSWORD,
# porque va dentro de DATABASE_URL.

# Postgres (contenedor db)
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=api_usuarios

# API. El host de la base es "db" (nombre del servicio en compose).
# La contraseña debe ser la misma que POSTGRES_PASSWORD.
DATABASE_URL=postgresql://app:CHANGE_ME@db:5432/api_usuarios?schema=public
PORT=3000

JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d

# Admin inicial (lo crea el seed). Cambia el password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000
LOGIN_THROTTLE_LIMIT=5
REGISTER_THROTTLE_LIMIT=3
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
